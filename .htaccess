# Disable directory browsing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. External Redirect: If /public is in browser URL bar, strip it out cleanly
    RewriteCond %{THE_REQUEST} \s/?[^/]+/public/([^\s?]*) [NC]
    RewriteRule ^public/(.*)$ %1 [R=301,L]

    RewriteCond %{THE_REQUEST} \s/?[^/]+/public[\s?] [NC]
    RewriteRule ^public/?$ ./ [R=301,L]

    # 2. Internal Rewrite: Route root to public/
    RewriteRule ^$ public/ [L]

    # 3. Internal Rewrite: Route all other requests to public/
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>
